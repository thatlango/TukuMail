# Copy to infrastructure/.env.prod on the dedicated mail VPS. Never commit the real file.
TUKUMAIL_HOSTNAME=mail.tukutuku.org
TUKUMAIL_WEB_PORT=8082
TUKUMAIL_TLS_DIR=/srv/tukumail/tls

JAMES_DATABASE=james
CONTROL_DATABASE=tukumail
POSTGRES_USER=james
POSTGRES_PASSWORD=replace-with-long-random-password

# Temporary v0 server-to-server key. Replace with Tuku Core service auth before customer self-service.
TUKUMAIL_PROVISIONING_KEY=replace-with-at-least-32-random-bytes

# Copy to infrastructure/.env.prod on the dedicated mail VPS. Never commit the real file.
TUKUMAIL_HOSTNAME=mail.tukutuku.org
TUKUMAIL_WEB_PORT=8082
TUKUMAIL_TLS_DIR=/srv/tukumail/tls

JAMES_DATABASE=james
CONTROL_DATABASE=tukumail
POSTGRES_USER=james
POSTGRES_PASSWORD=replace-with-long-random-password

# Temporary server-to-server provisioning key. Replace with Tuku Core service auth before customer self-service.
TUKUMAIL_PROVISIONING_KEY=replace-with-at-least-32-random-bytes

# Mail execution engine. Keep "james" until Engine v2 parity/cutover is explicitly approved.
TUKUMAIL_ENGINE_PROVIDER=james

# Private key shared only by the TukuMail control plane and Tuku Engine v2.
TUKUMAIL_ENGINE_V2_KEY=replace-with-at-least-32-random-bytes
TUKUMAIL_ENGINE_V2_SMTP_PORT=2525
TUKUMAIL_ENGINE_V2_IMAP_PORT=2143
TUKUMAIL_ENGINE_V2_LOG=tuku_engine_v2=info

# Optional outbound relay for the v2 pilot. Leave blank to keep remote mail durably queued.
TUKUMAIL_ENGINE_V2_RELAY_HOST=
TUKUMAIL_ENGINE_V2_RELAY_PORT=587
TUKUMAIL_ENGINE_V2_RELAY_USERNAME=
TUKUMAIL_ENGINE_V2_RELAY_PASSWORD=
